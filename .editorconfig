# Editors' settings for every file (https://editorconfig.org); the Python files are also laid out by ruff
# (ruff format, checked in CI)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

# a text's lines are kept exactly as written, and two spaces at a line's end are a Markdown line break
[{texts/*.txt,*.md}]
trim_trailing_whitespace = false
